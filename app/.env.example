# Primary (master) pooler, transaction mode, port 6543
DATABASE_URL=postgresql://app_write.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=verify-full
# Read replica dedicated pooler
DATABASE_REPLICA_URL=postgresql://app_read.PROJECT_REF:PASSWORD@REPLICA_HOST:6543/postgres?sslmode=verify-full
# Direct or session connection; only used by `npm run db:migrate`, never by the app
MIGRATION_DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=verify-full

AUTH_SECRET=replace-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional locally. When unset, the limiter is skipped; production must set these.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_KEY_SECRET=replace-with-openssl-rand-base64-32
